<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Dashboard</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

<nav>

    <h2>Dashboard</h2>

    <div>
        <a href="/posts">Public Posts</a>
        <a href="/dashboard">Dashboard</a>
    </div>

</nav>


<div class="container">

    <h1>
        Welcome, <%= user.name %>
    </h1>

    <p>
        Email: <%= user.email %>
    </p>

    <p>
        Role: <%= user.role %>
    </p>


    <h2>Your Posts</h2>


    <% if (posts.length === 0) { %>

        <div class="card">
            <p>You have not created any posts yet.</p>
        </div>

    <% } %>


    <% posts.forEach(post => { %>

        <div class="card">

            <% if (post.image) { %>

                <img
                    src="<%= post.image %>"
                    class="featured-image"
                    alt="Featured image"
                >

            <% } %>


            <h2>
                <%= post.title %>
            </h2>


            <p>
                <%= post.content %>
            </p>


            <p>

                Status:

                <% if (post.published) { %>

                    <strong>Published</strong>

                <% } else { %>

                    <strong>Draft</strong>

                <% } %>

            </p>


            <div>

                <% post.tags.forEach(tag => { %>

                    <span class="tag">
                        #<%= tag %>
                    </span>

                <% }) %>

            </div>


            <br>


            <button
                onclick="deletePost('<%= post._id %>')"
            >
                Delete
            </button>

        </div>

    <% }) %>

</div>


<script>

async function deletePost(id) {

    const confirmed =
        confirm("Are you sure you want to delete this post?");

    if (!confirmed) {
        return;
    }

    try {

        const response = await fetch(
            `/api/posts/${id}`,
            {
                method: "DELETE"
            }
        );

        const data = await response.json();

        if (!response.ok) {

            alert(data.message);

            return;
        }

        alert("Post deleted successfully");

        location.reload();

    } catch (error) {

        alert("Delete failed");

    }
}

</script>

</body>
</html>