<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Published Posts</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

<nav>

    <h2>My Blog</h2>

    <div>
        <a href="/posts">Posts</a>
        <a href="/login">Login</a>
        <a href="/dashboard">Dashboard</a>
    </div>

</nav>


<div class="container">

    <h1>Published Blog Posts</h1>

    <% if (posts.length === 0) { %>

        <div class="card">
            <p>No published posts available.</p>
        </div>

    <% } %>


    <div class="posts">

        <% posts.forEach(post => { %>

            <div class="card">

                <% if (post.image) { %>

                    <img
                        src="<%= post.image %>"
                        class="featured-image"
                        alt="Featured image"
                    >

                <% } %>


                <h2>
                    <%= post.title %>
                </h2>


                <p>
                    <%= post.content %>
                </p>


                <p>
                    <strong>Author:</strong>
                    <%= post.author.name %>
                </p>


                <div>

                    <% post.tags.forEach(tag => { %>

                        <span class="tag">
                            #<%= tag %>
                        </span>

                    <% }) %>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>